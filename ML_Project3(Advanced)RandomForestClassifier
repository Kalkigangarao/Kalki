df = pd.read_csv(StringIO(data2))


x = df.drop(columns = ['Applicant_ID','Loan_Approved'])
y = df['Loan_Approved']
x_train,x_test,y_train,y_test = train_test_split(x,y,test_size = 0.30,random_state = 42, stratify= y)


num_cols = ['Income_USD','Credit_Score','Debt_To_Income_Ratio','Loan_Amount_USD']

pp = ColumnTransformer(transformers=[
    ('num',QuantileTransformer(output_distribution='normal',random_state=42), num_cols),
    ('cat',TfidfVectorizer(max_features=10,stop_words='english'), 'Applicant_Notes')
],
remainder="drop",
)

pipline = Pipeline(steps=[
    ('pp',pp),
    ('smote',SMOTE(random_state=42)),
    ('rf',RandomForestClassifier(n_estimators=100, max_depth=10,min_samples_leaf=2,random_state=42,n_jobs=-1))
])

pipline.fit(x_train,y_train)

y_pred = pipline.predict(x_test)

print("Accuracy:", accuracy_score(y_test, y_pred))
print(classification_report(y_test, y_pred))

