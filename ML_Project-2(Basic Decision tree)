df = pd.read_csv(io.StringIO(data))

#Dropping unique columns because due to this unique columns the data gets leaked and overfitted
df = df.drop(columns = 'Student_ID')

x = df.drop(columns = 'Placed')
y = df['Placed']

x_train,x_test,y_train,y_test = train_test_split(x,y,test_size = 0.30,random_state = 42, stratify= y)

#Encoding text columns only
cat_column = ['City','Branch','Internship_Experience']
ohe = OneHotEncoder(drop ='first',sparse_output=False)
x_train_ohe = ohe.fit_transform(x_train[cat_column])
x_test_ohe = ohe.transform(x_test[cat_column])


#We don't need to use scaling in Decision trees
#Randomoversampler is used to balance the class0 and class1
ros = RandomOverSampler()
x_train_rs,y_train_rs = ros.fit_resample(x_train_ohe,y_train)

#Simply it is like IF-ELSE
#Using threshold conditions it classifies that weather it i true or false 
dt = DecisionTreeClassifier(max_depth=3,random_state=42)
dt.fit(x_train_rs,y_train_rs)

y_pred_dt = dt.predict(x_test_ohe)
print("Accuracy Score :\n",accuracy_score(y_test,y_pred_dt))
print("Classification Report:\n",classification_report(y_test,y_pred_dt))
